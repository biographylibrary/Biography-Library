# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.cursor/mcp.json

# Supabase CLI local cache (not committed; safe to delete)
supabase/.temp/

# Output di smoke test locale PDF→JPEG (non serve in repo; se un domani servisse versionarlo, togli questa riga e chiedi in review)
scripts/.test-cover.jpg

# Rapporto locale della conversione HTML → Markdown (può citare titoli di schede)
/reports/

# next-pwa writes these on every production build; keeping them versioned
# dirties the working tree after `next build`.
/public/sw.js
/public/workbox-*.js
/public/worker-*.js
/public/fallback-*.js
