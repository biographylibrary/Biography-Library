# ============================================
# Biography Library — Environment Variables
# ============================================
# Copy this file to .env.local for local development.
# Never commit .env.local to git.
#
# This file is the single documented list of every variable the project reads.
# `npm run check:env` compares it against the code and fails if they diverge,
# so a key added here but never read (or read but never listed) is caught in CI.
# A commented-out key counts as documented: comment it out when it is optional.
#
# Where each key must also be written, when you add or remove one:
#   1. .env.local                     — your machine (not committed)
#   2. this file                      — the documented list
#   3. /opt/bl-app/.env on Jelastic   — production, over SSH, by hand
#   4. Supabase Edge Function secrets — only for keys read by supabase/functions/*
#   5. .github/workflows/ci.yml       — only NEXT_PUBLIC_* needed to build

# ------------------
# Supabase (required by the Next.js app)
# ------------------
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# Server-only — required for /api/review/submit, /api/publication/*, /api/agents/*
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ------------------
# Infomaniak AI — Next.js API routes (/api/review/submit, /api/agents/*)
# ------------------
# Read server-side only (no NEXT_PUBLIC_ prefix).
# The /api/review/submit route calls Infomaniak directly, bypassing Edge Functions.
# Endpoint format: https://api.infomaniak.com/2/ai/<product_id>/openai/v1/chat/completions
INFOMANIAK_AI_ENDPOINT=https://api.infomaniak.com/2/ai/YOUR_PRODUCT_ID/openai/v1/chat/completions
INFOMANIAK_AI_TOKEN=your_infomaniak_ai_token_here
# OpenAI-compatible API root (without /chat/completions). Derived from INFOMANIAK_AI_ENDPOINT if unset.
# INFOMANIAK_AI_BASE_URL=https://api.infomaniak.com/2/ai/YOUR_PRODUCT_ID/openai/v1

# ------------------
# Application
# ------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical base for UM identifier resolution, spec section 9 (no trailing slash).
# Deliberately server-only: no NEXT_PUBLIC_ prefix, so it is not inlined at build
# time and a correction costs a restart instead of a new image. The browser gets
# it from GET /api/um-id/base-url. Required: the code throws if it is missing,
# because this address is printed inside deposited documents that cannot be fixed
# afterwards.
UM_ID_BASE_URL=https://id.biographylibrary.org
# Site name and URL used in transactional emails (shared/email/send.ts)
NEXT_PUBLIC_SITE_NAME=Biography Library
# NEXT_PUBLIC_SITE_URL=https://biographylibrary.org
# Optional GeoNames username for place search (falls back to Nominatim)
# GEONAMES_USERNAME=
# Set to 'true' to enable the PWA service worker in `next dev` (default: off in dev)
# NEXT_PUBLIC_ENABLE_PWA_DEV=false

# ------------------
# Agent platform (Next.js /api/agents/*)
# ------------------
# Model overrides. Each role falls back to the default in lib/agents/models.ts.
# AGENT_MODEL_COACH=google/gemma-4-31B-it
# AGENT_MODEL_COACH_FALLBACK=mistralai/Ministral-3-14B-Instruct-2512
# AGENT_MODEL_ONBOARDING=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-FP8
# AGENT_MODEL_ONBOARDING_FALLBACK=mistralai/Ministral-3-14B-Instruct-2512
# AGENT_MODEL_REVIEWER=google/gemma-4-31B-it
# AGENT_MODEL_REVIEWER_FALLBACK=mistralai/Ministral-3-14B-Instruct-2512
# AGENT_MODEL_APERTUS=swiss-ai/Apertus-70B-Instruct-2509
# AGENT_MODEL_APERTUS_FALLBACK=mistralai/Mistral-Small-4-119B-2603
# AGENT_EMBEDDING_MODEL=bge_multilingual_gemma2
# AGENT_EMBEDDING_MODEL_FALLBACK=bge_multilingual_gemma2
# Skip the remote model catalog lookup at startup (set to 'true' offline)
# AGENT_SKIP_MODEL_CATALOG=true
#
# Rate limits (lib/agents/thread-service.ts)
# AGENT_DAILY_LIMIT=80
# AGENT_BURST_LIMIT=10
#
# Context and compaction (lib/agents/agent-limits.ts)
# AGENT_CONTEXT_MESSAGE_LIMIT=60
# AGENT_UI_MESSAGE_LIMIT=200
# AGENT_COMPRESS_AFTER_MESSAGES=25
# AGENT_KEEP_RECENT_RAW=30
# AGENT_SUMMARY_MAX_CHARS=1500

# ------------------
# Echo voice — Mistral Voxtral TTS (see docs/ECHO_VOICE.md)
# ------------------
# MISTRAL_API_KEY=
# ECHO_TTS_MODEL=voxtral-mini-tts-2603
# Optional voice slugs from La Plateforme (list via Mistral API /audio/voices)
# Defaults to en_paul_neutral for all UI languages if unset
# ECHO_TTS_VOICE=en_paul_neutral
# ECHO_TTS_VOICE_IT=en_paul_neutral
# ECHO_TTS_VOICE_EN=en_paul_neutral
# ECHO_TTS_VOICE_FR=en_paul_neutral
# ECHO_TTS_VOICE_DE=en_paul_neutral

# ------------------
# Transactional email (Resend) — Next.js side
# ------------------
# The same two keys must also be set as Edge Function secrets (see below).
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Biography Library <noreply@biographylibrary.org>
# Shared secret protecting the cron and webhook routes. Must match the value
# set as an Edge Function secret, or the webhooks will be rejected.
CRON_SECRET=generate_a_long_random_string

# ------------------
# Tooling only — not read by the running app
# ------------------
# Supabase CLI token used by scripts/setup-supabase-email-production.mjs
# SUPABASE_ACCESS_TOKEN=

# ------------------
# Supabase Edge Function secrets
# ------------------
# These are NOT .env variables — set them via the Supabase dashboard
# (Project Settings → Edge Functions → Secrets) or the Supabase MCP tool.
# Listed here because `npm run check:env` reads supabase/functions/* too, and
# because a missing one fails silently in production.
#
# SUPABASE_URL                  — auto-populated by the Supabase runtime
# SUPABASE_ANON_KEY             — auto-populated by the Supabase runtime
# SUPABASE_SERVICE_ROLE_KEY     — auto-populated by the Supabase runtime
# INFOMANIAK_AI_TOKEN           — same token as above
# INFOMANIAK_AI_ENDPOINT        — same endpoint URL as above
# INFOMANIAK_AI_MODEL_PRIMARY   — ai-assistant (default: google/gemma-4-31B-it)
# INFOMANIAK_AI_MODEL_FALLBACK  — ai-assistant fallback (default: mistralai/Mistral-Small-4-119B-2603)
# AI_RATE_LIMIT                 — per-user per-minute request cap (default: 5)
# AI_DAILY_LIMIT                — per-user daily cap (default: 40)
# AI_WEEKLY_LIMIT               — per-user weekly cap (default: 200)
# RESEND_API_KEY                — same key as above
# RESEND_FROM_EMAIL             — same sender as above
# CRON_SECRET                   — same shared secret as above
# AUTH_HOOK_SECRET              — Supabase Auth Send Email Hook → auth-send-email
# SITE_NAME                     — name used in email templates (Edge side)
# SITE_URL                      — base URL used in email links (Edge side)
# ENGAGEMENT_EMAILS_ENABLED     — send-engagement-emails on/off (default: true)
# PDF_DRAFT_REMINDER_DAYS       — days before the G2 reminder (default: 7)
